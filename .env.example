# The app (sign in, register, dashboards). The website reads its settings from
# the app's public API and sends the Contact and waitlist forms there.
NEXT_PUBLIC_APP_URL=https://app.lankastay.com

# This website's own address: canonical links, sitemap, share images.
SITE_URL=https://lankastay.com

# Optional: while "Coming soon" is on, open /preview?key=<this> to see the real
# pages in your browser. Any long random text. Leave empty to turn it off.
PREVIEW_KEY=

